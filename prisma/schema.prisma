generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Conventions: tables in snake_case via @@map, columns in camelCase.
// User, Session, Account, Verification and RateLimit follow the shape Better Auth
// expects (see `npx auth generate`); extra fields are ours.

// ── Enums ──────────────────────────────────────────────

enum Occupation {
  STUDENT
  PROFESSOR
  COMPANY
  RESEARCHER
  DEVELOPER
  OTHER
}

enum AuthProvider {
  GITHUB
  LINKEDIN
}

// ── Identity & auth (Better Auth) ──────────────────────

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  // username plugin. Optional so OAuth sign-ups can be created; a username is
  // derived from the provider handle when there is one.
  username        String? @unique
  displayUsername String?

  // admin plugin. `role` is text because the plugin stores role names as strings;
  // valid values ("reader" | "writer" | "admin") are enforced by lib/auth/permissions.ts.
  role       String    @default("reader")
  banned     Boolean   @default(false)
  banReason  String?
  banExpires DateTime?

  // Master admin (ADR 0005). A partial unique index in the migration allows only one.
  isSuperAdmin       Boolean @default(false)
  mustChangePassword Boolean @default(false)

  // Last time the profile photo changed: limits how often images are processed.
  avatarUpdatedAt DateTime?

  // When this person accepted the terms, and which version (Decreto 285, traceability).
  termsAcceptedAt DateTime?
  termsVersion    String?

  profile               Profile?
  sessions              Session[]
  accounts              Account[]
  identityVerifications IdentityVerification[]
  articles              Article[]              @relation("ArticleAuthor")
  coAuthorships         ArticleCoAuthor[]
  media                 Media[]
  comments              Comment[]
  articleLikes          ArticleLike[]
  articleReads          ArticleRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id             String   @id
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String? // admin plugin
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// Authentication methods of a user: the password ("credential") or a linked
// OAuth provider ("github", "linkedin"). Linking ≠ verification ≠ role.
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // scrypt hash, only for providerId "credential"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Better Auth's short-lived tokens (password reset, email verification).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

// ── Product ────────────────────────────────────────────

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio         String?     @db.VarChar(280)
  description String?     @db.VarChar(2000)
  occupation  Occupation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// Fact: "this provider confirms this user's public identity" (byline badges).
// Created when a GitHub/LinkedIn account is linked, removed when it is unlinked.
model IdentityVerification {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   AuthProvider
  verifiedAt DateTime     @default(now())

  @@unique([userId, provider])
  @@map("identity_verifications")
}

// ── Editorial ──────────────────────────────────────────

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// SHOWCASE categories are "projects"; EDITORIAL ones are blog articles.
enum CategoryKind {
  SHOWCASE
  EDITORIAL
}

/// Language the article is written in. Content is never machine-translated.
enum ContentLanguage {
  ES
  EN
}

/// Fixed set seeded by the editorial migration. Names come from messages/*.json by slug.
model Category {
  id       String       @id @default(cuid())
  slug     String       @unique
  kind     CategoryKind
  position Int

  articles Article[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String @db.VarChar(40)

  articles ArticleTag[]

  @@map("tags")
}

model Article {
  id             String          @id @default(cuid())
  /// Generated from the title; frozen once the article is first published.
  slug           String          @unique
  title          String          @db.VarChar(160)
  excerpt        String          @default("") @db.VarChar(300)
  /// TipTap (ProseMirror) JSON document, validated server-side (lib/editor/content.ts).
  content        Json
  /// Plain text extracted from `content`, for search and reading time.
  contentText    String          @default("")
  language       ContentLanguage @default(ES)
  status         ArticleStatus   @default(DRAFT)
  coverImageKey  String?
  coverAlt       String?         @db.VarChar(200)
  repositoryUrl  String?         @db.VarChar(500)
  externalUrl    String?         @db.VarChar(500)
  readingMinutes Int             @default(1)
  publishedAt    DateTime?

  // Restrict: articles are never deleted as a side effect of deleting a user or category.
  authorId   String
  author     User     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  coAuthors ArticleCoAuthor[]
  tags      ArticleTag[]
  comments  Comment[]
  likes     ArticleLike[]
  reads     ArticleRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([authorId])
  @@map("articles")
}

/// Ordered co-authors (N:M). Co-authors can edit; only the author publishes.
model ArticleCoAuthor {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@id([articleId, userId])
  @@index([userId])
  @@map("article_co_authors")
}

model ArticleTag {
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

/// Uploaded files in object storage (ADR 0008). Keys are immutable.
model Media {
  id         String   @id @default(cuid())
  key        String   @unique
  mimeType   String
  width      Int
  height     Int
  bytes      Int
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([uploaderId])
  @@map("media")
}

// ── Community ──────────────────────────────────────────

/// One level of replies, enforced in lib/community/mutations.ts. A comment that
/// still has replies is kept as a tombstone (deletedAt set, body emptied).
model Comment {
  id        String    @id @default(cuid())
  articleId String
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  body      String    @db.VarChar(2000)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId, parentId, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model ArticleLike {
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([articleId, userId])
  @@index([userId, createdAt])
  @@map("article_likes")
}

/// Private reading history behind the dashboard: signed-in users only, one row
/// per user and article, no IP or anonymous data (ADR 0009).
model ArticleRead {
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstReadAt DateTime @default(now())
  lastReadAt  DateTime @default(now())

  @@id([articleId, userId])
  @@index([userId, lastReadAt])
  @@map("article_reads")
}
