generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────

enum Role {
  READER
  WRITER
  ADMIN
}

enum Occupation {
  STUDENT
  PROFESSOR
  COMPANY
  RESEARCHER
  DEVELOPER
  OTHER
}

enum AuthProvider {
  GITHUB
  LINKEDIN
}

// ── Models ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String?  // null when the user only signed up through OAuth
  role         Role     @default(READER)

  profile       Profile?
  accounts      Account[]
  verifications Verification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String?
  avatarUrl   String?
  bio         String?  @db.VarChar(280)
  description String?
  occupation  Occupation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// A linked external account (OAuth sign-in / sign-up)
model Account {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider          AuthProvider
  providerAccountId String

  createdAt DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Fact: "this provider confirms this user's public identity".
// Kept separate from Account even though both come from the same OAuth flow today.
model Verification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider   AuthProvider
  verifiedAt DateTime @default(now())

  @@unique([userId, provider])
  @@map("verifications")
}