# ─────────────────────────────────────────────────────────────
# GZ Group — environment template
#
# Copy to `.env` for local development:  cp .env.example .env
# Never commit real values. `.env*` is git-ignored (except this file).
#
# Where each variable lives per environment:
#   Local dev  → .env (this template)
#   CI         → set inline in .github/workflows/ci.yml (throwaway values);
#                real secrets, when needed, go to GitHub Actions Secrets
#   Production → Dokploy application "Environment" tab (never in the image)
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# Local: matches docker-compose.yml. Production: the internal connection
# string of the Dokploy-managed PostgreSQL service.
DATABASE_URL="postgresql://gz_user:gz_password@localhost:5432/gz_group_dev?schema=public"

# ── App ──────────────────────────────────────────────────────
# Public base URL (absolute links, metadata). Production: https://<your-domain>
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Auth: Better Auth ────────────────────────────────────────
# 32+ random characters, different per environment:  openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Base URL for auth callbacks and email links. Production: https://<your-domain>
BETTER_AUTH_URL="http://localhost:3000"

# ── Master admin bootstrap (ADR 0005) ────────────────────────
# Created once at server start if no master admin exists. The password must be
# 16+ characters; it must be changed at first sign-in. Remove it from the
# environment after that first sign-in (it is ignored once the admin exists).
ADMIN_EMAIL="admin@gzgroup.dev"
ADMIN_INITIAL_PASSWORD=""

# ── Email: self-hosted SMTP (ADR 0006) ───────────────────────
# Local dev without SMTP_HOST prints emails (and their links) to the terminal.
# SMTP_SECURE="true" for implicit TLS (port 465); "false" uses STARTTLS (587).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="GZ Group <no-reply@gzgroup.dev>"
# Optional override: smtp | console | file  (file is used by the e2e suite)
EMAIL_TRANSPORT=""

# ── Object storage: S3-compatible, RustFS locally (ADR 0008) ─
# Local values match docker-compose.yml. Production: the S3/RustFS endpoint and
# credentials of the deployment. The bucket is created at server start if missing.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="gz_dev_access"
S3_SECRET_ACCESS_KEY="gz_dev_secret_change_me"
S3_BUCKET="gz-media"
S3_FORCE_PATH_STYLE="true"

# ── Legal ────────────────────────────────────────────────
# Contact shown in /privacy for data-protection requests. Required before launch.
LEGAL_CONTACT_EMAIL=""

# ── OAuth providers ──────────────────────────────────────────
# A provider is enabled only when both values are set.
# GitHub callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Prepared, not active yet ("Sign In with LinkedIn using OpenID Connect").
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
